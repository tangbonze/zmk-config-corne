if SHIELD_CORNE_LEFT

# 本键盘的 central（主控）接在左手：左手负责 USB / BLE 与 Studio 通信
config ZMK_KEYBOARD_NAME
    # 蓝牙设备名限制 16 字节
    default "Corne DYA"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNE_LEFT || SHIELD_CORNE_RIGHT

config ZMK_SPLIT
    default y

# 以下默认项来自 ZMK 上游 corne shield，本地覆盖时不能丢掉
if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
