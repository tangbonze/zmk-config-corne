#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        // LOWER + RAISE 同按 -> ADJUST（F 键 / 媒体 / 蓝牙管理层）
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T      |   |  Y         |  U         |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G      |   |  H         |  J         |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B      |   |  N         |  M         |  ,  |  .  |  /  | SHFT |
            //                    | GUI | LWR |  SPC    |   | ENT        | BKSP/RSE   | ALT |
            //
            // 右侧第 2 枚拇指键（ENT 右边）：点按 = 退格，按住 = RAISE 层

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U            &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J            &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M            &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LGUI  &mo 1  &kp SPACE    &kp ENTER  &lt 2 BACKSPACE  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5    |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | CAPS | LFT | DWN |  UP | RGT |       |   | Vo- | MUT | Vo+ |     |     |      |
            // | SHFT |     |     |     |     |       |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE  &kp N1    &kp N2    &kp N3  &kp N4     &kp N5    &kp N6  &kp N7        &kp N8      &kp N9        &kp N0  &trans
&kp CAPS    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none     &none   &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans
&kp LSHFT   &trans    &trans    &trans  &trans     &trans    &trans  &trans        &trans      &trans        &trans  &trans
                                &trans  &trans     &trans    &trans  &trans        &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  DEL |
            // | CTRL |  A  | BT1 | BT2 | BT3 |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT | OUT |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | STUDIO | ->ADJ | SPC |   | ENT |     | ALT |
            //
            // 左侧第 1 枚拇指键：解锁 DYA Studio；第 2 枚：按住进入 ADJUST 层
            // （BT_CLR 移到了 ADJUST 层，避免误触清掉蓝牙配对）

            bindings = <
&trans  &kp EXCL     &kp AT        &kp HASH      &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LPAR  &kp RPAR  &kp DEL
&trans  &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans       &kp MINUS  &kp EQUAL  &kp LBKT      &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_TOG  &trans        &trans        &trans        &trans       &kp UNDER  &kp PLUS   &kp LBRC      &kp RBRC  &kp PIPE  &kp TILDE
                                  &studio_unlock  &mo 3         &trans       &trans     &trans     &trans
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |  F1 | F2 | F3 | F4 | F5 | F6  |   | F7  | F8  | F9  | F10 | F11 | F12   |
            // | bri+|    |prev| PP |next|     |   |     | MUT | Vo- | Vo+ |     |       |
            // | bri-|    |    |    |    | BT1 |   | BT2 |     |     |     |     | BTCLR |
            //                      | BTLDR |     |     |     |     |     |
            //
            // 进入方式：LOWER + RAISE 同按（conditional layer），或 RAISE 中按住左侧
            // 第 2 枚拇指键。左下角拇指键 = 进 bootloader（三键组合，不易误触）。

            bindings = <
&kp F1        &kp F2  &kp F3     &kp F4    &kp F5     &kp F6        &kp F7        &kp F8    &kp F9      &kp F10      &kp F11      &kp F12
&kp C_BRI_UP  &trans  &kp C_PREV &kp C_PP  &kp C_NEXT &trans        &trans        &trans    &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
&kp C_BRI_DN  &trans  &trans     &trans    &trans     &bt BT_SEL 0  &bt BT_SEL 1  &trans    &trans      &trans       &trans       &bt BT_CLR
                                           &bootloader  &trans        &trans        &trans    &trans      &trans
            >;
        };
    };
};
